# ==============================================================================
# BloodLink Production & Development Environment Configuration
# ==============================================================================

# 1. SUPABASE CONFIGURATION (Required for real multi-user database & auth)
# Obtain these from your Supabase Project Settings -> API:
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# 2. SECRET ADMIN ACCESS KEY (For Server-Side / Supabase SQL verification only)
# Never expose this in frontend code or Git. Configure in Supabase SQL:
# app.settings.admin_secret_key="YOUR_CUSTOM_SECRET_ADMIN_KEY"
# Default development fallback key: BLOODLINK_SECURE_ADMIN_2026_ROOT

# 2. FIREBASE CLOUD MESSAGING (Optional - for Web Push Notifications)
# Obtain from Firebase Console -> Project Settings -> Cloud Messaging:
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_VAPID_KEY=your-vapid-public-key

# 3. SMS & WHATSAPP GATEWAY (Secure Backend Edge Function use only)
# Never expose these in frontend code. Set these in Supabase Edge Functions Secrets:
# SUPABASE_SMS_PROVIDER=msg91_or_twilio
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_PHONE_NUMBER=+1234567890
# MSG91_AUTH_KEY=your_msg91_key
# MSG91_TEMPLATE_ID=your_dlt_template_id

# 4. APPLICATION SETTINGS
VITE_APP_NAME="BloodLink"
VITE_APP_URL=http://localhost:5173
VITE_DEFAULT_RADIUS_KM=25
